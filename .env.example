# Copy to .env and fill with a freshly generated deployer key (never commit .env).
#
#   cast wallet new
#   export DEPLOYER=$(cast wallet address --private-key 0x<SK>)
#
# Set deployConfig.mainnet.yaml roles.* and salt deployer fields to $DEPLOYER.
# See pod-integration-tests/deployments/builder/MAINNET.md §0a.

DEPLOY_CONFIG=deployConfig.mainnet.yaml
PRIVATE_KEY=

# Optional per-chain signers (default: PRIVATE_KEY for all)
# ETHEREUM_PRIVATE_KEY=
# AVALANCHE_PRIVATE_KEY=
# COTI_MAINNET_PRIVATE_KEY=

# Fork / dry-run RPC overrides (localhost when forks.enabled)
# COTI_MAINNET_RPC_URL=http://127.0.0.1:8546
# AVALANCHE_RPC_URL=http://127.0.0.1:8545
# ETHEREUM_RPC_URL=http://127.0.0.1:8545
